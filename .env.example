# ────────── Database ──────────
# SQLite (dev): file:./dev.db
# Postgres (prod): postgresql://user:pass@host:5432/dbname?sslmode=require
DATABASE_URL="file:./dev.db"

# ────────── NextAuth ──────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# ────────── Stripe ──────────
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Create products + monthly recurring prices, paste the price IDs here:
# https://dashboard.stripe.com/test/products
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_PREMIUM="price_..."

# ────────── Cron ──────────
# Random secret used by /api/cron/* endpoints (header: "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET="change-me"

# ────────── Email (Fase 4) ──────────
# Get a free key from https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="TrovaPro <noreply@trovapro.it>"

# ────────── Storage (Fase 4) ──────────
